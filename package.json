{
    "name": "spotify_knockoff",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbo",
        "build": "next build",
        "test": "npm run build",
        "start": "next start -p 4072",
        "ytmatch:worker": "node --env-file=.env.local workers/ytMatchWorker.js",
        "metadata:worker": "node --env-file=.env.local workers/metadataWorker.js",
        "metadata:coverage": "node scripts/metadataCoverageReport.js",
        "populate:charts": "node workers/chartsWorker.js",
        "crawl:artists": "node workers/artistCrawler.js",
        "expand:worker": "node workers/artistExpandWorker.js",
        "coexistence:matrix": "node scripts/workerCoexistenceMatrix.js --report graphify-out/worker-coexistence-matrix.json",
        "coexistence:smoke": "node tests/worker-coexistence.smoke.js --check queue-isolation",
        "coexistence:verify": "npm run coexistence:matrix && node scripts/workerCoexistenceReport.js --report graphify-out/worker-coexistence-matrix.json && npm run coexistence:smoke",
        "repair:artists": "node scripts/repairEmptyArtists.js",
        "repair:albums": "node scripts/repairAlbumImages.js",
        "repair:all": "node scripts/repairMissingFields.js",
        "db:status": "node scripts/dbStatus.js",
        "enrich:genres": "node scripts/enrichGenres.js",
        "enrich:genres:dry": "node scripts/enrichGenres.js --dry-run",
        "genres:propagate:albums": "node scripts/propagateAlbumGenres.js",
        "genres:propagate:albums:dry": "node scripts/propagateAlbumGenres.js --dry-run",
        "genres:propagate": "node scripts/propagateArtistGenres.js",
        "genres:propagate:dry": "node scripts/propagateArtistGenres.js --dry-run",
        "genres:normalize": "node scripts/normalizeGenres.js",
        "genres:normalize:dry": "node scripts/normalizeGenres.js --dry-run",
        "genres:pipeline": "node scripts/enrichGenres.js && node scripts/propagateAlbumGenres.js && node scripts/propagateArtistGenres.js && node scripts/normalizeGenres.js",
        "genres:pipeline:dry": "node scripts/enrichGenres.js --dry-run --limit 200 && node scripts/propagateAlbumGenres.js --dry-run --limit 200 && node scripts/propagateArtistGenres.js --dry-run --limit 200 && node scripts/normalizeGenres.js --dry-run --limit 200"
    },
    "dependencies": {
        "@ducanh2912/next-pwa": "^10.2.9",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "cookie": "^1.1.1",
        "crypto-js": "^4.2.0",
        "framer-motion": "^12.35.1",
        "ioredis": "^5.10.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.577.0",
        "mongoose": "^9.2.3",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "sass": "^1.97.3",
        "spotify-url-info": "^3.2.18",
        "youtubei.js": "^17.0.1",
        "yt-search": "^2.13.1"
    },
    "devDependencies": {
        "sharp": "^0.34.5"
    }
}
